# Copiá este archivo como .env (en la misma carpeta) y completá las claves.
# El servidor lo vuelve a leer en cada pedido: no hace falta reiniciar al cambiarlo.

# OBLIGATORIA · Gemini (Google AI Studio → Get API key)
# Analiza las referencias, redacta el brief, separa piezas y lee los colores para la paleta.
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Para "Generar con DALL·E" en 03 SISTEMA (platform.openai.com → API keys)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Opcionales
# Modelo que interpreta el pedido como director de arte (Responses API)
# OPENAI_TEXT_MODEL=gpt-5
# Modelo de imagen (si no está disponible se prueba gpt-image-2 y luego gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high
# Puerto del servidor (la app lo espera en 3000)
# PORT=3000
